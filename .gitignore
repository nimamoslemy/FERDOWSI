# User private settings & API keys (never commit)
settings.json
secrets.json
.env
.env.*
*.key
*.pem
*.pfx

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class

# Debug symbols, raw executables & temp build artifacts (use ZIP installer instead of raw .exe)
*.pdb
*.obj
*.exp
*.lib
*.exe
*.dll
